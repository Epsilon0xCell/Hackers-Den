[2025-04-14 21:29:15,227][DEBUG][org.apache.http.wire] http-outgoing-1 << "  &lt;p&gt;&lt;img src=&quot;https://content.govdelivery.com/attachments/fancy_images/USDHSCISA/2020/06/3486054/05152023-gov-delivery-banner-copy_original.png&quot; alt=&quot;Cybersecurity and Infrastructure Security Agency (CISA)&quot; title=&quot;&quot; width=&quot;600&quot; height=&quot;100&quot;&gt;&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,227][DEBUG][org.apache.http.wire] http-outgoing-1 << "  &lt;p&gt;You are subscribed to Cybersecurity Advisories for Cybersecurity and Infrastructure Security Agency. This information has recently been updated and is now available.&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,227][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_item&quot; style=&quot;margin-bottom: 2em;&quot;&gt;[\n]"
[2025-04-14 21:29:15,227][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_title&quot; style=&quot;font-weight: bold; font-size: 120%; margin: 0 0 0.3em; padding: 0;&quot;&gt;&lt;a href=&quot;https://www.cisa.gov/news-events/alerts/2025/03/18/supply-chain-compromise-third-party-github-action-cve-2025-30066&quot; target=&quot;_blank&quot; title=&quot;Supply Chain Compromise of Third-Party GitHub Action, CVE-2025-30066&quot; rel=&quot;noopener&quot;&gt;Supply Chain Compromise of Third-Party GitHub Action, CVE-2025-30066&lt;/a&gt;&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,227][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_pub_date&quot; style=&quot;font-size: 90%; font-style: italic; color: #666666; margin: 0 0 0.3em; padding: 0;&quot;&gt;03/19/2025 11:00 AM EDT&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,227][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_description&quot; style=&quot;margin: 0 0 0.3em; padding: 0;&quot;&gt;[\n]"
[2025-04-14 21:29:15,227][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
[2025-04-14 21:29:15,227][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;A popular third-party GitHub Action, tj-actions/changed-files"
[2025-04-14 21:29:15,229][DEBUG][org.apache.http.wire] http-outgoing-1 << " (tracked as &lt;a href=&quot;https://www.cve.org/CVERecord?id=CVE-2025-30066&quot; target=&quot;_blank&quot; title=&quot;CVE-2025-30066&quot; rel=&quot;noopener&quot;&gt;CVE-2025-30066&lt;/a&gt;), was compromised. This GitHub Action is designed to detect which files have changed in a pull request or commit. The supply chain compromise allows for information disclosure of secrets including, but not limited to, valid access keys, GitHub Personal Access Tokens (PATs), npm tokens, and private RSA keys. This has been patched in v46.0.1.[0xc2][0xa0]&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,229][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,229][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
[2025-04-14 21:29:15,229][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA added CVE-2025-30066 to its &lt;a href=&quot;https://www.cisa.gov/known-exploited-vulnerabilities-catalog&quot; target=&quot;_blank&quot; title=&quot;Known Exploited Vulnerabilities Catalog&quot; rel=&quot;noopener&quot;&gt;Known Exploited Vulnerabilities Catalog&lt;/a&gt;.[0xc2][0xa0]&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,229][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,229][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
[2025-04-14 21:29:15,229][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA strongly urges users to implement the recommendations to mitigate this compromise and strengthen security when using third-party actions.[0xc2][0xa0][0xc2][0xa0]&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,229][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,229][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
[2025-04-14 21:29:15,229][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;See the following resources for more guidance:[0xc2][0xa0]&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,229][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,229][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
