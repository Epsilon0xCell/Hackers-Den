[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "  &lt;p&gt;&lt;img src=&quot;https://content.govdelivery.com/attachments/fancy_images/USDHSCISA/2020/06/3486054/05152023-gov-delivery-banner-copy_original.png&quot; alt=&quot;Cybersecurity and Infrastructure Security Agency (CISA)&quot; title=&quot;&quot; width=&quot;600&quot; height=&quot;100&quot;&gt;&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "  &lt;p&gt;You are subscribed to Cybersecurity Advisories for Cybersecurity and Infrastructure Security Agency. This information has recently been updated and is now available.&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;[0xc2][0xa0]&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_item&quot; style=&quot;margin-bottom: 2em;&quot;&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_title&quot; style=&quot;font-weight: bold; font-size: 120%; margin: 0 0 0.3em; padding: 0;&quot;&gt;&lt;a href=&quot;https://www.cisa.gov/news-events/alerts/2025/02/20/cisa-releases-eight-industrial-control-systems-advisories&quot;&gt;CISA Releases Eight Industrial Control Systems Advisories&lt;/a&gt;&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_pub_date&quot; style=&quot;font-size: 90%; font-style: italic; color: #666666; margin: 0 0 0.3em; padding: 0;&quot;&gt;02/20/2025 01:00 PM EST&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;br&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_description&quot; style=&quot;margin: 0 0 0.3em; padding: 0;&quot;&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA released eight Industrial Control Systems (ICS) advisories on February 20, 2025. These advisories provide timely information about current security issues, vulnerabilities, and exploits surrounding ICS.&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-051-01 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-051-01&quot;&gt;ABB ASPECT-Enterprise, NEXUS, and MATRIX Series&lt;/a&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-051-02 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-051-02&quot;&gt;ABB FLXEON Controllers&lt;/a&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-051-03 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-051-03&quot;&gt;Carrier Block Load&lt;/a&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-051-04 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-051-04&quot;&gt;Siemens SiPass Integrated&lt;/a&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-051-05 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-051-05&quot;&gt;Rapid Response Monitoring My Security Account App&lt;/a&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-051-06 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-051-06&quot;&gt;Elseta Vinci Protocol Analyzer&lt;/a&gt;&lt;br&gt;[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-24-291-03 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-24-291-03&quot;&gt;Mitsubishi Electric CNC Series (Update A)&lt;/a&gt;&lt;br&gt;[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSMA-25-051-01 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-medical-advisories/icsma-25-051-01&quot;&gt;Medixant RadiAnt DICOM Viewer&lt;/a&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-14 21:29:15,410][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA encourages users and administrators to review newly released ICS advisories for technical details and mitigations.&lt;/p&gt;[\n]"
