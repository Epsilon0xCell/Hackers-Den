[2025-04-14 21:29:13,613][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                    &lt;span&gt;[\n]"
[2025-04-14 21:29:13,613][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                        &lt;strong&gt;Compromising Threat Actor Communications (12 minute read)&lt;/strong&gt;[\n]"
[2025-04-14 21:29:13,613][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                    &lt;/span&gt;[\n]"
[2025-04-14 21:29:13,613][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;/a&gt;[\n]"
[2025-04-14 21:29:13,613][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;br&gt;[\n]"
