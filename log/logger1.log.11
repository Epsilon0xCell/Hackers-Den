[2025-04-14 21:29:13,373][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                        &lt;strong&gt;Fake Microsoft Office Add-In Tools Push Malware via SourceForge (2 minute read)&lt;/strong&gt;[\n]"
[2025-04-14 21:29:13,373][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                    &lt;/span&gt;[\n]"
[2025-04-14 21:29:13,373][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;/a&gt;[\n]"
[2025-04-14 21:29:13,373][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;br&gt;[\n]"
