[2025-04-14 21:29:15,278][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;br&gt;[\n]"
[2025-04-14 21:29:15,278][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_description&quot; style=&quot;margin: 0 0 0.3em; padding: 0;&quot;&gt;[\n]"
[2025-04-14 21:29:15,278][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA released three Industrial Control Systems (ICS) advisories on March 6, 2025. These advisories provide timely information about current security issues, vulnerabilities, and exploits surrounding ICS.&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,278][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-14 21:29:15,278][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-065-01 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-065-01&quot;&gt;Hitachi Energy PCU400&lt;/a&gt;[\n]"
[2025-04-14 21:29:15,278][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,278][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-065-02 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-065-02&quot;&gt;Hitachi Energy Relion 670/650/SAM600-IO&lt;/a&gt;&lt;br&gt;[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,278][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-037-02 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-037-01&quot;&gt;Schneider Electric EcoStruxure (Update A)&lt;/a&gt;&lt;br&gt;[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,278][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-14 21:29:15,278][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA encourages users and administrators to review newly released ICS advisories for technical details and mitigations.&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,278][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;&lt;span&gt;This product is provided subject to this[0xc2][0xa0]&lt;/span&gt;&lt;a href=&quot;https://www.cisa.gov/notification&quot; target=&quot;_blank&quot; title=&quot;Follow link&quot; rel=&quot;noopener&quot;&gt;Notification&lt;/a&gt;&lt;span&gt;[0xc2][0xa0]and this[0xc2][0xa0]&lt;/span&gt;&lt;a href=&quot;https://www.cisa.gov/privacy-policy&quot; target=&quot;_blank&quot; title=&quot;Follow link&quot; rel=&quot;noopener&quot;&gt;Privacy &amp;amp; Use&lt;/a&gt;&lt;span&gt;[0xc2][0xa0]policy.&lt;/span&gt;&lt;/p&gt;[\n]"
