[2025-04-14 21:29:13,350][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                        &lt;strong&gt;Researchers Hack Source Code From Google Gemini (7 minute read)&lt;/strong&gt;[\n]"
[2025-04-14 21:29:13,350][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                    &lt;/span&gt;[\n]"
[2025-04-14 21:29:13,350][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;/a&gt;[\n]"
[2025-04-14 21:29:13,350][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;br&gt;[\n]"
[2025-04-14 21:29:13,350][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;br&gt;[\n]"
