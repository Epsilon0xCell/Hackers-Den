[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "  [\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "  &lt;p&gt;&lt;img src=&quot;https://content.govdelivery.com/attachments/fancy_images/USDHSCISA/2020/06/3486054/05152023-gov-delivery-banner-copy_original.png&quot; alt=&quot;Cybersecurity and Infrastructure Security Agency (CISA)&quot; title=&quot;&quot; width=&quot;600&quot; height=&quot;100&quot;&gt;&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "  &lt;p&gt;You are subscribed to Cybersecurity Advisories for Cybersecurity and Infrastructure Security Agency. This information has recently been updated and is now available.&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_item&quot; style=&quot;margin-bottom: 2em;&quot;&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_title&quot; style=&quot;font-weight: bold; font-size: 120%; margin: 0 0 0.3em; padding: 0;&quot;&gt;&lt;a href=&quot;https://www.cisa.gov/news-events/alerts/2025/03/28/cisa-releases-malware-analysis-report-resurge-malware-associated-ivanti-connect-secure&quot; target=&quot;_blank&quot; title=&quot;CISA Releases Malware Analysis Report on RESURGE Malware Associated with Ivanti Connect Secure&quot; rel=&quot;noopener&quot;&gt;CISA Releases Malware Analysis Report on RESURGE Malware Associated with Ivanti Connect Secure&lt;/a&gt;&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_pub_date&quot; style=&quot;font-size: 90%; font-style: italic; color: #666666; margin: 0 0 0.3em; padding: 0;&quot;&gt;03/28/2025 05:00 PM EDT&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_description&quot; style=&quot;margin: 0 0 0.3em; padding: 0;&quot;&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;ListContainerWrapper SCXW26512359 BCX8&quot;&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA has published a Malware Analysis Report (MAR) with analysis and associated detection signatures on a new malware variant CISA has identified as RESURGE. RESURGE contains capabilities of the SPAWNCHIMERA[&lt;a href=&quot;https://blogs.jpcert.or.jp/en/2025/02/spawnchimera.html&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;&lt;u&gt;1&lt;/u&gt;&lt;/a&gt;] malware variant, including surviving reboots; however, RESURGE contains distinctive commands that alter its behavior. These commands:[0xc2][0xa0]&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;Create a web shell, manipulate integrity checks, and modify files.[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;Enable the use of web shells for credential harvesting, account creation, password resets, and escalating permissions.[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;Copy the web shell to the Ivanti running boot disk and manipulate the running coreboot image.[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;RESURGE is associated with the exploitation of &lt;a href=&quot;https://www.cve.org/CVERecord?id=CVE-2025-0282&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;&lt;u&gt;CVE-2025-0282&lt;/u&gt;&lt;/a&gt; in Ivanti Connect Secure appliances. CVE-2025-0282 is a stack-based buffer overflow vulnerability in Ivanti Connect Secure, Policy Secure, and ZTA Gateways. CISA added CVE-2025-0282 to its &lt;a href=&quot;https://www.cisa.gov/known-exploited-vulnerabilities-catalog&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;&lt;u&gt;Known Exploited Vulnerabilities Catalog&lt;/u&gt;&lt;/a&gt; on January 8, 2025.[0xc2][0xa0][0xc2][0xa0]&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,181][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,182][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
[2025-04-14 21:29:15,182][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;For more information on the abovementioned malware variants and YARA rules for detection, see: &lt;a href=&quot;https://www.cisa.gov/news-events/analysis-reports/ar25-087a&quot;&gt;MAR-25993211.R1.V1.CLEAR.&lt;/a&gt;&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,182][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;For a downloadable copy of the SIGMA rule associated with this MAR, see: &lt;a href=&quot;https://links-2.govdelivery.com/CL0/%2Fsites%2Fdefault%2Ffiles%2F2025-03%2FAR25-087A%2520SIGMA%2520YAML.pdf/1/01010195de970"
[2025-04-14 21:29:15,184][DEBUG][org.apache.http.wire] http-outgoing-1 << "b89-ccd9140f-0f0d-46bc-8bb2-31c14695de05-000000/rmCon0XnDDdZQt_A2lnvqVMCAb13zQR-4Xx2UP2I6xY=398&quot;&gt;AR25-087A SIGMA YAML.&lt;/a&gt;&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,184][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,184][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
[2025-04-14 21:29:15,184][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA urges users and administrators to implement the following actions in addition to the &lt;a href=&quot;https://www.cisa.gov/cisa-mitigation-instructions-cve-2025-0282&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;&lt;u&gt;Mitigation Instructions for CVE-2025-0282&lt;/u&gt;&lt;/a&gt;:[0xc2][0xa0]&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,184][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,184][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
[2025-04-14 21:29:15,184][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-14 21:29:15,184][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;[\n]"
[2025-04-14 21:29:15,184][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;strong&gt;For the highest level of confidence, conduct a factory reset.&lt;/strong&gt;[\n]"
[2025-04-14 21:29:15,184][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-14 21:29:15,184][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;[\n]"
[2025-04-14 21:29:15,184][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;strong&gt;For Cloud and Virtual systems, conduct a factory reset using an external known clean image of the device.&lt;/strong&gt;[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,184][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-14 21:29:15,184][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,184][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-14 21:29:15,184][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,184][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
[2025-04-14 21:29:15,184][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-14 21:29:15,184][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;See Ivanti[0xe2][0x80][0x99]s &lt;a href=&quot;https://forums.ivanti.com/s/article/Recovery-Steps?language=en_US&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;&lt;u&gt;Recommended Recovery Steps&lt;/u&gt;&lt;/a&gt; for more information, including how to conduct a factory reset.[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;Reset credentials of privileged and non-privileged accounts.[0xc2][0xa0][0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;Reset passwords for all domain users and all local accounts, such as Guest, HelpAssistant, DefaultAccount, System, Administrator, and krbtgt. The krbtgt account is responsible for handling Kerberos ticket requests as well as encrypting and signing them. The krbtgt account should be reset twice because the account has a two-password history. The first account reset for the krbtgt needs to be allowed to replicate prior to the second reset to avoid any issues. See CISA[0xe2][0x80][0x99]s &lt;a href=&quot;https://www.cisa.gov/news-events/analysis-reports/ar21-134a&quot;&gt;Eviction Guidance for Networks Affected by the SolarWinds and Active Directory/M365 Compromise&lt;/a&gt; for more information. Although tailored to Federal Civilian Executive Branch (FCEB) agencies compromised in the 2020 SolarWinds Orion supply chain compromise, the steps are applicable to organizations with Windows AD compromise.[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;Review access policies to temporarily revoke privileges/access for affected devices. If it is necessary to not alert the attacker (e.g., for intelligence purposes), then privileges can be reduced for affected accounts/devices to [0xe2][0x80][0x9c]contain[0xe2][0x80][0x9d] them.[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;Reset the relevant account credentials or access keys if the investigation finds the threat actor[0xe2][0x80][0x99]s access is limited to non-elevated permissions.[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;Monitor related accounts, especially administrative accounts, for any further signs of unauthorized access.[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;Organizations should report incidents and anomalous activity related to information found in the malware analysis report to CISA[0xe2][0x80][0x99]s 24/7 Operations Center at &lt;a href=&quot;mailto:Report@cisa.gov&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;&lt;u&gt;Report@cisa.gov&lt;/u&gt;&lt;/a&gt; or (888) 282-0870. Malware submissions can be made directly to Malware Nextgen at &lt;a href=&quot;https://malware.cisa.gov/&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;&lt;u&gt;https://malware.cisa.gov&lt;/u&gt;&lt;/a&gt;.[0xc2][0xa0]&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;See the following resources for more guidance:[0xc2][0xa0]&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,185][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
