[2025-04-14 21:29:13,480][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                        &lt;strong&gt;Expert used ChatGPT-4o to create a replica of his passport in just 5 minutes bypassing KYC (2 minute read)&lt;/strong&gt;[\n]"
[2025-04-14 21:29:13,480][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                    &lt;/span&gt;[\n]"
[2025-04-14 21:29:13,480][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;/a&gt;[\n]"
[2025-04-14 21:29:13,480][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;br&gt;[\n]"
