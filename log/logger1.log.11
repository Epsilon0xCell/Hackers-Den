[2025-04-14 21:29:15,211][DEBUG][org.apache.http.wire] http-outgoing-1 << "  &lt;p&gt;&lt;img src=&quot;https://content.govdelivery.com/attachments/fancy_images/USDHSCISA/2020/06/3486054/05152023-gov-delivery-banner-copy_original.png&quot; alt=&quot;Cybersecurity and Infrastructure Security Agency (CISA)&quot; title=&quot;&quot; width=&quot;600&quot; height=&quot;100&quot;&gt;&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,211][DEBUG][org.apache.http.wire] http-outgoing-1 << "  &lt;p&gt;You are subscribed to Cybersecurity Advisories for Cybersecurity and Infrastructure Security Agency. This information has recently been updated and is now available.&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,211][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;[0xc2][0xa0]&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,211][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_item&quot; style=&quot;margin-bottom: 2em;&quot;&gt;[\n]"
[2025-04-14 21:29:15,211][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_title&quot; style=&quot;font-weight: bold; font-size: 120%; margin: 0 0 0.3em; padding: 0;&quot;&gt;&lt;a href=&quot;https://www.cisa.gov/news-events/alerts/2025/03/20/cisa-releases-five-industrial-control-systems-advisories&quot;&gt;CISA Releases Five Industrial Control Systems Advisories&lt;/a&gt;&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,211][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_pub_date&quot; style=&quot;font-size: 90%; font-style: italic; color: #666666; margin: 0 0 0.3em; padding: 0;&quot;&gt;03/20/2025 01:15 PM EDT&lt;/div&gt;[\n]"
[2025-04-14 21:29:15,211][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;br&gt;[\n]"
[2025-04-14 21:29:15,211][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_description&quot; style=&quot;margin: 0 0 0.3em; padding: 0;&quot;&gt;[\n]"
[2025-04-14 21:29:15,211][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA released five Industrial Control Systems (ICS) advisories on March20, 2025. These advisories provide timely information about current security issues, vulnerabilities, and exploits surrounding ICS.&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,211][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-14 21:29:15,212][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-079-01 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-079-01&quot;&gt;Schneider Electric EcoStruxure[0xe2][0x84][0xa2]&lt;/a&gt;[\n]"
[2025-04-14 21:29:15,212][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,212][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-079-02 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-079-02&quot;&gt;Schneider Electric Enerlin[0xe2][0x80][0x99]X IFE and eIFE&lt;/a&gt;[\n]"
[2025-04-14 21:29:15,212][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,212][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-079-03 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-079-03&quot;&gt;Siemens Simcenter Femap&lt;/a&gt;[\n]"
[2025-04-14 21:29:15,212][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,212][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-079-04 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-079-04&quot;&gt;SMA Sunny Portal&lt;/a&gt;&lt;br&gt;[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,212][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSMA-25-079-01 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-medical-advisories/icsma-25-079-01&quot;&gt;Santesoft Sante DICOM Viewer Pro[0xc2][0xa0]&lt;/a&gt;[\n]"
[2025-04-14 21:29:15,212][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-14 21:29:15,212][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-14 21:29:15,212][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA encourages users and administrators to review newly released ICS advisories for technical details and mitigations.&lt;/p&gt;[\n]"
[2025-04-14 21:29:15,212][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;&lt;span&gt;This product is provided subject to this[0xc2][0xa0]&lt;/span&gt;&lt;a href=&quot;https://www.cisa.gov/notification&quot; target=&quot;_blank&quot; title=&quot;Follow link&quot; rel=&quot;noopener&quot;&gt;Notification&lt;/a&gt;&lt;span&gt;[0xc2][0xa0]and this[0xc2][0xa0]&lt;/span&gt;&lt;a href=&quot;https://www.cisa.gov/privacy-policy&quot; target=&quot;_blank&quot; title=&quot;Follow link&quot; rel=&quot;noopener&quot;&gt;Privacy &amp;amp; Use&lt;/a&gt;&lt;span&gt;[0xc2][0xa0]policy.&lt;/span&gt;&lt;/p&gt;[\n]"
