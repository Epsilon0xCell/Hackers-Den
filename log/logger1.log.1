[2025-04-15 21:52:20,513][DEBUG][org.apache.http.wire] http-outgoing-18 << "                                        &lt;strong&gt;Outlaw Linux Malware: Persistent, Unsophisticated, and Surprisingly Effective (33 minute read)&lt;/strong&gt;[\n]"
[2025-04-15 21:52:20,513][DEBUG][org.apache.http.wire] http-outgoing-18 << "                                    &lt;/span&gt;[\n]"
[2025-04-15 21:52:20,513][DEBUG][org.apache.http.wire] http-outgoing-18 << "&lt;/a&gt;[\n]"
[2025-04-15 21:52:20,513][DEBUG][org.apache.http.wire] http-outgoing-18 << "&lt;br&gt;[\n]"
