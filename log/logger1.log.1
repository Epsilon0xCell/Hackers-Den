[2025-04-15 21:52:21,394][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;div class=&quot;rss_description&quot; style=&quot;margin: 0 0 0.3em; padding: 0;&quot;&gt;[\n]"
[2025-04-15 21:52:21,394][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;p&gt;CISA released five Industrial Control Systems (ICS) advisories on March20, 2025. These advisories provide timely information about current security issues, vulnerabilities, and exploits surrounding ICS.&lt;/p&gt;[\n]"
[2025-04-15 21:52:21,394][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;ul&gt;[\n]"
[2025-04-15 21:52:21,394][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSA-25-079-01 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-079-01&quot;&gt;Schneider Electric EcoStruxure[0xe2][0x84][0xa2]&lt;/a&gt;[\n]"
[2025-04-15 21:52:21,394][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,395][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSA-25-079-02 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-079-02&quot;&gt;Schneider Electric Enerlin[0xe2][0x80][0x99]X IFE and eIFE&lt;/a&gt;[\n]"
[2025-04-15 21:52:21,395][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,395][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSA-25-079-03 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-079-03&quot;&gt;Siemens Simcenter Femap&lt;/a&gt;[\n]"
[2025-04-15 21:52:21,395][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,395][DEBUG][org.apache.http.wire] http-outgoing-19 << "&"
[2025-04-15 21:52:21,395][DEBUG][org.apache.http.wire] http-outgoing-19 << "lt;li&gt;ICSA-25-079-04 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-079-04&quot;&gt;SMA Sunny Portal&lt;/a&gt;&lt;br&gt;[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,395][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSMA-25-079-01 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-medical-advisories/icsma-25-079-01&quot;&gt;Santesoft Sante DICOM Viewer Pro[0xc2][0xa0]&lt;/a&gt;[\n]"
[2025-04-15 21:52:21,395][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,395][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/ul&gt;[\n]"
[2025-04-15 21:52:21,395][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;p&gt;CISA encourages users and administrators to review newly released ICS advisories for technical details and mitigations.&lt;/p&gt;[\n]"
