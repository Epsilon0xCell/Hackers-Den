[2025-04-15 21:52:15,687][DEBUG][org.apache.http.wire] http-outgoing-6 << "[0x9][0x9][0x9][0x9]<category><![CDATA[A Little Sunshine]]></category>[\n]"
[2025-04-15 21:52:15,687][DEBUG][org.apache.http.wire] http-outgoing-6 << "[0x9][0x9]<category><![CDATA[Russia's War on Ukraine]]></category>[\n]"
[2025-04-15 21:52:15,687][DEBUG][org.apache.http.wire] http-outgoing-6 << "[0x9][0x9]<category><![CDATA[Artem Tamoian]]></category>[\n]"
[2025-04-15 21:52:15,687][DEBUG][org.apache.http.wire] http-outgoing-6 << "[0x9][0x9]<category><![CDATA[DuckDuckGo]]></category>[\n]"
[2025-04-15 21:52:15,687][DEBUG][org.apache.http.wire] http-outgoing-6 << "[0x9][0x9]<category><![CDATA[Freedom of Russia legion]]></category>[\n]"
[2025-04-15 21:52:15,687][DEBUG][org.apache.http.wire] http-outgoing-6 << "[0x9][0x9]<category><![CDATA[Russian Volunteer Corps]]></category>[\n]"
