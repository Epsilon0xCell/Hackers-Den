[2025-04-15 21:52:21,534][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;div class=&quot;rss_title&quot; style=&quot;font-weight: bold; font-size: 120%; margin: 0 0 0.3em; padding: 0;&quot;&gt;&lt;a href=&quot;https://www.cisa.gov/news-events/alerts/2025/02/06/cisa-releases-six-industrial-control-systems-advisories&quot;&gt;CISA Releases Six Industrial Control Systems Advisories&lt;/a&gt;&lt;/div&gt;[\n]"
[2025-04-15 21:52:21,534][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;div class=&quot;rss_pub_date&quot; style=&quot;font-size: 90%; font-style: italic; color: #666666; margin: 0 0 0.3em; padding: 0;&quot;&gt;02/06/2025 01:45 PM EST&lt;/div&gt;[\n]"
[2025-04-15 21:52:21,534][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;br&gt;[\n]"
[2025-04-15 21:52:21,534][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;div class=&quot;rss_description&quot; style=&quot;margin: 0 0 0.3em; padding: 0;&quot;&gt;[\n]"
[2025-04-15 21:52:21,534][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;p&gt;CISA released six Industrial Control Systems (ICS) advisories on February 6, 2025. These advisories provide timely information about current security issues, vulnerabilities, and exploits surrounding ICS.&lt;/p&gt;[\n]"
[2025-04-15 21:52:21,535][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;ul&gt;[\n]"
[2025-04-15 21:52:21,535][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSA-25-037-01 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-037-01&quot;&gt;Schneider Electric EcoStruxure Power Monitoring Expert (PME)&lt;/a&gt;[\n]"
[2025-04-15 21:52:21,535][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,535][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSA-25-037-02 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-037-02&quot;&gt;Schneider Electric EcoStruxure&lt;/a&gt;[\n]"
[2025-04-15 21:52:21,535][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,535][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSA-25-037-03 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-037-03&quot;&gt;ABB Drive Composer&lt;/a&gt;[\n]"
[2025-04-15 21:52:21,535][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,535][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSA-25-037-04 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-037-04&quot;&gt;Trimble Cityworks&lt;/a&gt;[\n]"
[2025-04-15 21:52:21,535][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,535][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSMA-25-037-01 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-medical-advisories/icsma-25-037-01&quot;&gt;MicroDicom DICOM Viewer&lt;/a&gt;[\n]"
[2025-04-15 21:52:21,535][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,535][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSMA-25-037-02 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-medical-advisories/icsma-25-037-02&quot;&gt;Orthanc Server&lt;/a&gt;[\n]"
[2025-04-15 21:52:21,535][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/li&gt;[\n]"
