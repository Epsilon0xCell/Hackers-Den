[2025-04-15 21:52:21,551][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;div class=&quot;rss_title&quot; style=&quot;font-weight: bold; font-size: 120%; margin: 0 0 0.3em; padding: 0;&quot;&gt;&lt;a href=&quot;https://www.cisa.gov/news-events/alerts/2025/01/30/cisa-releases-eight-industrial-control-systems-advisories&quot;&gt;CISA Releases Eight Industrial Control Systems Advisories&lt;/a&gt;&lt;/div&gt;[\n]"
[2025-04-15 21:52:21,551][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;div class=&quot;rss_pub_date&quot; style=&quot;font-size: 90%; font-style: italic; color: #666666; margin: 0 0 0.3em; padding: 0;&quot;&gt;01/30/2025 07:00 AM EST&lt;/div&gt;[\n]"
[2025-04-15 21:52:21,551][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;br&gt;[\n]"
[2025-04-15 21:52:21,551][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;div class=&quot;rss_description&quot; style=&quot;margin: 0 0 0.3em; padding: 0;&quot;&gt;[\n]"
[2025-04-15 21:52:21,551][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;p&gt;CISA released eight Industrial Control Systems (ICS) advisories on January 30, 2025. These advisories provide timely information about current security issues, vulnerabilities, and exploits surrounding ICS.&lt;/p&gt;[\n]"
[2025-04-15 21:52:21,551][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;ul&gt;[\n]"
[2025-04-15 21:52:21,551][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSA-25-030-01 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-030-01&quot;&gt;Hitachi Energy UNEM&lt;/a&gt;[\n]"
[2025-04-15 21:52:21,551][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/"
[2025-04-15 21:52:21,552][DEBUG][org.apache.http.wire] http-outgoing-19 << "li&gt;[\n]"
[2025-04-15 21:52:21,552][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSA-25-030-02 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-030-02&quot;&gt;New Rock Technologies Cloud Connected Devices&lt;/a&gt;[\n]"
[2025-04-15 21:52:21,552][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,552][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSA-25-030-03 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-030-03&quot;&gt;Schneider Electric System Monitor Application in Harmony and Pro-face PS5000 Legacy Industrial PCs&lt;/a&gt;[\n]"
[2025-04-15 21:52:21,552][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,552][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSA-25-030-04 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-030-04&quot;&gt;Rockwell Automation KEPServer&lt;/a&gt;[\n]"
[2025-04-15 21:52:21,552][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,552][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSA-25-030-05 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-030-05&quot;&gt;Rockwell Automation FactoryTalk AssetCentre&lt;/a&gt;&lt;br&gt;[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,552][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSMA-25-030-01 &lt;a href=&quot;https://cisa.gov/news-events/ics-medical-advisories/icsma-25-030-01&quot;&gt;Contec Health CMS8000 Patient Monitor&lt;/a&gt;[0xc2][0xa0]&lt;br&gt;[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,552][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSA-24-135-04 &lt;a href=&quot;https://cisa.gov/news-events/ics-advisories/icsa-24-135-04&quot;&gt;Mitsubishi Electric Multiple FA Engineering Software Products (Update B)&lt;/a&gt;[\n]"
[2025-04-15 21:52:21,552][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,552][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSMA-22-244-01 &lt;a href=&quot;https://cisa.gov/news-events/ics-medical-advisories/icsma-22-244-01&quot;&gt;Contec Health CMS8000 Patient Monitor (Update A)&lt;/a&gt;[\n]"
[2025-04-15 21:52:21,552][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,552][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/ul&gt;[\n]"
[2025-04-15 21:52:21,552][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;p&gt;CISA encourages users and administrators to review newly released ICS advisories for technical details and mitigations.&lt;/p&gt;[\n]"
