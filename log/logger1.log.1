[2025-04-15 21:52:21,505][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 10.0pt; color: #757575;&quot;&gt;Connect with CISA: &lt;br&gt;&lt;/span&gt;&lt;a href=&quot;https://www.facebook.com/CISA&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;&lt;span style=&quot;font-size: 10.0pt; color: #00568c;&quot;&gt;Facebook&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot;font-size: 10.0pt; color: #757575;&quot;&gt;[0xc2][0xa0] |[0xc2][0xa0] &lt;/span&gt;&lt;a href=&quot;https://twitter.com/CISAgov&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;&lt;span style=&quot;font-size: 10.0pt; color: #00568c;&quot;&gt;Twitter&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot;font-size: 10.0pt; color: #757575;&quot;&gt;[0xc2][0xa0] |[0xc2][0xa0] &lt;/span&gt;&lt;a href=&quot;https://Instagram.com/cisagov&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;&lt;span style=&quot;font-size: 10.0pt; color: #00568c;&quot;&gt;Instagram&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot;font-size: 10.0pt; color: #757575;&quot;&gt;[0xc2][0xa0] |[0xc2][0xa0] &lt;/span&gt;&lt;a href=&quot;https://www.linkedin.com/company/cybersecurity-and-infrastructure-security-agency&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;&lt;span style=&quot;font-size: 10.0pt; color: #00568c;&quot;&gt;LinkedIn&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot;font-size: 10.0pt; color: #757575;&quot;&gt;[0xc2][0xa0] |[0xc2][0xa0][0xc2][0xa0] &lt;/span&gt;&lt;a href=&quot;https://www.youtube.com/channel/UCxyq9roe-npgzrVwbpoAy0A&quot; target=&quot;_self&quot;&gt;&lt;span style=&quot;font-size: 10.0pt; color: #00568c;&quot;&gt;YouTube&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot;font-size: 10.0pt; color: #757575;&quot;&gt;&lt;/span&gt;&lt;/p&gt;[\n]"
