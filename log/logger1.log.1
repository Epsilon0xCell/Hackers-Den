[2025-04-15 21:52:20,663][DEBUG][org.apache.http.wire] http-outgoing-18 << "                                &lt;a href=&quot;https://tracking.tldrnewsletter.com/CL0/https:%2F%2Fwww.chainguard.dev%2Flibraries%3Futm_source=TLDRinfosec%26utm_medium=email%26utm_content=email-ad/2/01000195dce3cb04-ff7d9d86-f278-4f1c-bb1e-f8d0da35abc8-000000/hcTIkPBGYu6SrsWiyGu_QcbAKlWgM4LIPW-JUX9ZMH4=398&quot;&gt;[\n]"
[2025-04-15 21:52:20,663][DEBUG][org.apache.http.wire] http-outgoing-18 << "                                    &lt;span&gt;[\n]"
[2025-04-15 21:52:20,663][DEBUG][org.apache.http.wire] http-outgoing-18 << "                                        &lt;strong&gt;[0xf0][0x9f][0x86][0x95]&amp;nbsp;Chainguard Libraries: Guarded Java Language Dependencies to Eliminate Supply Chain Attacks (Sponsor)&lt;/strong&gt;[\n]"
[2025-04-15 21:52:20,663][DEBUG][org.apache.http.wire] http-outgoing-18 << "                                    &lt;/span&gt;[\n]"
[2025-04-15 21:52:20,663][DEBUG][org.apache.http.wire] http-outgoing-18 << "&lt;/a&gt;[\n]"
[2025-04-15 21:52:20,663][DEBUG][org.apache.http.wire] http-outgoing-18 << "[\n]"
