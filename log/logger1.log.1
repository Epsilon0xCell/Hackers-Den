[2025-04-15 21:52:20,504][DEBUG][org.apache.http.wire] http-outgoing-18 << "                                        &lt;strong&gt;attest-build-provenance (GitHub Repo)&lt;/strong&gt;[\n]"
[2025-04-15 21:52:20,504][DEBUG][org.apache.http.wire] http-outgoing-18 << "                                    &lt;/span&gt;[\n]"
[2025-04-15 21:52:20,504][DEBUG][org.apache.http.wire] http-outgoing-18 << "&lt;/a&gt;[\n]"
[2025-04-15 21:52:20,504][DEBUG][org.apache.http.wire] http-outgoing-18 << "&lt;br&gt;[\n]"
