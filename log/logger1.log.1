[2025-04-15 21:52:21,442][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;div class=&quot;rss_title&quot; style=&quot;font-weight: bold; font-size: 120%; margin: 0 0 0.3em; padding: 0;&quot;&gt;&lt;a href=&quot;https://www.cisa.gov/news-events/alerts/2025/02/27/cisa-releases-two-industrial-control-systems-advisories&quot;&gt;CISA Releases Two Industrial Control Systems Advisories&lt;/a&gt;&lt;/div&gt;[\n]"
[2025-04-15 21:52:21,442][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;div class=&quot;rss_pub_date&quot; style=&quot;font-size: 90%; font-style: italic; color: #666666; margin: 0 0 0.3em; padding: 0;&quot;&gt;02/27/2025 01:45 PM EST&lt;/div&gt;[\n]"
[2025-04-15 21:52:21,442][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;br&gt;[\n]"
[2025-04-15 21:52:21,442][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;div class=&quot;rss_description&quot; style=&quot;margin: 0 0 0.3em; padding: 0;&quot;&gt;[\n]"
[2025-04-15 21:52:21,442][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;p&gt;CISA released two Industrial Control Systems (ICS) advisories on February 27, 2025. These advisories provide timely information about current security issues, vulnerabilities, and exploits surrounding ICS.&lt;/p&gt;[\n]"
[2025-04-15 21:52:21,442][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;ul&gt;[\n]"
[2025-04-15 21:52:21,442][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSA-25-058-01 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-058-01&quot;&gt;Schneider Electric Communication Modules for Modicon M580 and Quantum Controllers&lt;/a&gt;&lt;br&gt;[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,442][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSMA-25-058-01 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-medical-advisories/icsma-25-058-01&quot;&gt;Dario Health USB-C Blood Glucose Monitoring System Starter Kit Android Application&lt;/a&gt;&lt;br&gt;[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,442][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/ul&gt;[\n]"
[2025-04-15 21:52:21,442][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;p&gt;CISA encourages users and administrators to review newly released ICS advisories for technical details and mitigations.&lt;/p&gt;[\n]"
[2025-04-15 21:52:21,442][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;p&gt;&lt;span&gt;This product is provided subject to this[0xc2][0xa0]&lt;/span&gt;&lt;a href=&quot;https://www.cisa.gov/notification&quot; target=&quot;_blank&quot; title=&quot;Follow link&quot; rel=&quot;noopener&quot;&gt;Notification&lt;/a&gt;&lt;span&gt;[0xc2][0xa0]and this[0xc2][0xa0]&lt;/span&gt;&lt;a href=&quot;https://www.cisa.gov/privacy-policy&quot; target=&quot;_blank&quot; title=&quot;Follow link&quot; rel=&quot;noopener&quot;&gt;Privacy &amp;amp; Use&lt;/a&gt;&lt;span&gt;[0xc2][0xa0]policy.&lt;/span&gt;&lt;/p&gt;[\n]"
