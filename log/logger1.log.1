[2025-04-15 21:52:21,502][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,502][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSA-25-051-03 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-051-03&quot;&gt;Carrier Block Load&lt;/a&gt;[\n]"
[2025-04-15 21:52:21,502][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,502][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSA-25-051-04 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-051-04&quot;&gt;Siemens SiPass Integrated&lt;/a&gt;[\n]"
[2025-04-15 21:52:21,502][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/li&gt;[\n]"
[2025-04-15 21:52:21,502][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSA-25-051-05 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-051-05&quot;&gt;Rapid Response Monitoring My Security Account App&lt;/a&gt;[\n]"
