[2025-04-14 22:05:00,918][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                    &lt;/span&gt;[\n]"
[2025-04-14 22:05:00,918][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;/a&gt;[\n]"
[2025-04-14 22:05:00,918][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;br&gt;[\n]"
