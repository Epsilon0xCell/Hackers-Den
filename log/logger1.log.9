[2025-04-14 22:05:02,315][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-14 22:05:02,315][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-084-03 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-084-03&quot;&gt;Rockwell Automation 440G TLS-Z&lt;/a&gt;[\n]"
[2025-04-14 22:05:02,315][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-14 22:05:02,315][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-084-04 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-084-04&quot;&gt;Inaba Denki Sangyo CHOCO TEI WATCHER Mini[0xc2][0xa0]&lt;/a&gt;&lt;br&gt;[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-14 22:05:02,315][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-14 22:05:02,315][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA encourages users and administrators to review newly released ICS advisories for technical details and mitigations.&lt;/p&gt;[\n]"
