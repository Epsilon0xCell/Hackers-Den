[2025-04-14 22:05:02,438][DEBUG][org.apache.http.wire] http-outgoing-1 << "  &lt;p&gt;&lt;img src=&quot;https://content.govdelivery.com/attachments/fancy_images/USDHSCISA/2020/06/3486054/05152023-gov-delivery-banner-copy_original.png&quot; alt=&quot;Cybersecurity and Infrastructure Security Agency (CISA)&quot; title=&quot;&quot; width=&quot;600&quot; height=&quot;100&quot;&gt;&lt;/p&gt;[\n]"
[2025-04-14 22:05:02,438][DEBUG][org.apache.http.wire] http-outgoing-1 << "  &lt;p&gt;You are subscribed to Cybersecurity Advisories for Cybersecurity and Infrastructure Security Agency. This information has recently been updated and is now available.&lt;/p&gt;[\n]"
[2025-04-14 22:05:02,438][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_item&quot; style=&quot;margin-bottom: 2em;&quot;&gt;[\n]"
[2025-04-14 22:05:02,438][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_title&quot; style=&quot;font-weight: bold; font-size: 120%; margin: 0 0 0.3em; padding: 0;&quot;&gt;&lt;a href=&quot;https://www.cisa.gov/news-events/alerts/2025/03/06/fbi-warns-data-extortion-scam-targeting-corporate-executives&quot;&gt;FBI Warns of Data Extortion Scam Targeting Corporate Executives&lt;/a&gt;&lt;/div&gt;[\n]"
[2025-04-14 22:05:02,438][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_pub_date&quot; style=&quot;font-size: 90%; font-style: italic; color: #666666; margin: 0 0 0.3em; padding: 0;&quot;&gt;03/06/2025 02:00 PM EST&lt;/div&gt;[\n]"
[2025-04-14 22:05:02,438][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_description&quot; style=&quot;margin: 0 0 0.3em; padding: 0;&quot;&gt;[\n]"
[2025-04-14 22:05:02,438][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;The Federal Bureau of Investigation (FBI) Internet Crime Complaint Center (IC3) has released an alert warning of a scam involving criminal actors masquerading as the [0xe2][0x80][0x9c]BianLian Group.[0xe2][0x80][0x9d] The cyber criminals target corporate executives by sending extortion letters threatening to release victims[0xe2][0x80][0x99] sensitive information unless payment is received.&lt;/p&gt;[\n]"
[2025-04-14 22:05:02,438][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA encourages organizations to review the[0xc2][0xa0]following FBI Public Service Announcement for more information:&lt;/p&gt;[\n]"
[2025-04-14 22:05:02,438][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-14 22:05:02,438][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;&lt;a href=&quot;https://www.ic3.gov/PSA/2025/PSA250306-2&quot; title=&quot;Mail Scam Targeting Corporate Executives Claims Ties to Ransomware&quot;&gt;Mail Scam Targeting Corporate Executives Claims Ties to Ransomware&lt;/a&gt;&lt;/li&gt;[\n]"
[2025-04-14 22:05:02,438][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-14 22:05:02,438][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;Organizations should report incidents and anomalous activity to CISA[0xe2][0x80][0x99]s 24/7 Operations Center at &lt;a href=&quot;mailto:Report@cisa.gov&quot;&gt;Report@cisa.gov&lt;/a&gt; or (888) 282-0870.[0xc2][0xa0]&lt;/p&gt;[\n]"
[2025-04-14 22:05:02,438][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_item&quot;&gt;[\n]"
