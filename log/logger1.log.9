[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "  &lt;p&gt;&lt;img src=&quot;https://content.govdelivery.com/attachments/fancy_images/USDHSCISA/2020/06/3486054/05152023-gov-delivery-banner-copy_original.png&quot; alt=&quot;Cybersecurity and Infrastructure Security Agency (CISA)&quot; title=&quot;&quot; width=&quot;600&quot; height=&quot;100&quot;&gt;&lt;/p&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "  &lt;p&gt;You are subscribed to Cybersecurity Advisories for Cybersecurity and Infrastructure Security Agency. This information has recently been updated and is now available.&lt;/p&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;[0xc2][0xa0]&lt;/p&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_item&quot; style=&quot;margin-bottom: 2em;&quot;&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_title&quot; style=&quot;font-weight: bold; font-size: 120%; margin: 0 0 0.3em; padding: 0;&quot;&gt;&lt;a href=&quot;https://www.cisa.gov/news-events/alerts/2025/02/07/trimble-releases-security-updates-address-vulnerability-cityworks-software&quot;&gt;Trimble Releases Security Updates to Address a Vulnerability in Cityworks Software&lt;/a&gt;&lt;/div&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_pub_date&quot; style=&quot;font-size: 90%; font-style: italic; color: #666666; margin: 0 0 0.3em; padding: 0;&quot;&gt;02/07/2025 02:00 PM EST&lt;/div&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;br&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_description&quot; style=&quot;margin: 0 0 0.3em; padding: 0;&quot;&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;OutlineElement Ltr SCXW211317631 BCX8&quot;&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA is collaborating with private industry partners to respond to reports of exploitation of a vulnerability (CVE-2025-0994) discovered by Trimble impacting its Cityworks Server AMS (Asset Management System). Trimble has released security updates and an advisory addressing a recently discovered a deserialization vulnerability enabling an external actor to potentially conduct remote code execution (RCE) against a customer[0xe2][0x80][0x99]s Microsoft Internet Information Services (IIS) web server.[0xc2][0xa0]&lt;/p&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA has added CVE-2025-0994 to its &lt;a href=&quot;https://www.cisa.gov/known-exploited-vulnerabilities-catalog&quot;&gt;Known Exploited Vulnerabilities Catalog&lt;/a&gt;, based on evidence of active exploitation.[0xc2][0xa0]&lt;/p&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;OutlineElement Ltr SCXW211317631 BCX8&quot;&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA strongly encourages users and administrators to search for indicators of compromise (IOCs) and apply the necessary updates and workarounds.[0xc2][0xa0]&lt;/p&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;OutlineElement Ltr SCXW211317631 BCX8&quot;&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;Review the following article for more information:[0xc2][0xa0]&lt;/p&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;ListContainerWrapper SCXW211317631 BCX8&quot;&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;&lt;a href=&quot;https://learn.assetlifecycle.trimble.com/i/1532182-cityworks-customer-communication-2025-02-05-docx/0?&quot; title=&quot;Trimble Advisory&quot;&gt;Trimble Advisory and IOCs for Vulnerability Affecting Cityworks Deployments[0xc2][0xa0]&lt;/a&gt;&lt;/li&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-14 22:05:02,653][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/div&gt;[\n]"
