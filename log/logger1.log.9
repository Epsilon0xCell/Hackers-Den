[2025-04-14 22:05:00,818][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                        &lt;strong&gt;Outlaw Linux Malware: Persistent, Unsophisticated, and Surprisingly Effective (33 minute read)&lt;/strong&gt;[\n]"
[2025-04-14 22:05:00,818][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                    &lt;/span&gt;[\n]"
[2025-04-14 22:05:00,818][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;/a&gt;[\n]"
[2025-04-14 22:05:00,818][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;br&gt;[\n]"
