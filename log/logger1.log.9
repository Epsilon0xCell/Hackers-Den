[2025-04-14 21:29:33,140][DEBUG][org.apache.http.wire] http-outgoing-55 << "                                <a href="https://tracking.tldrnewsletter.com/CL0/https:%2F%2Fwww.theregister.com%2F2025%2F04%2F12%2Fai_code_suggestions_sabotage_supply_chain%2F%3Futm_source=tldrinfosec/1/010001963473c645-a6712889-9ec2-4205-94fa-f1e41d7eae95-000000/Bx68SLaQwq7jWpHAUTFrBT7CHwoh9qe1ekWGvSCd7M4=400">[\n]"
[2025-04-14 21:29:33,140][DEBUG][org.apache.http.wire] http-outgoing-55 << "                                    <span>[\n]"
[2025-04-14 21:29:33,140][DEBUG][org.apache.http.wire] http-outgoing-55 << "                                        <strong>LLMs can't stop making up software dependencies and sabotaging everything (5 minute read)</strong>[\n]"
[2025-04-14 21:29:33,140][DEBUG][org.apache.http.wire] http-outgoing-55 << "                                    </span>[\n]"
[2025-04-14 21:29:33,140][DEBUG][org.apache.http.wire] http-outgoing-55 << "</a>[\n]"
