[2025-04-14 22:05:02,710][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_item&quot; style=&quot;margin-bottom: 2em;&quot;&gt;[\n]"
[2025-04-14 22:05:02,711][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_title&quot; style=&quot;font-weight: bold; font-size: 120%; margin: 0 0 0.3em; padding: 0;&quot;&gt;&lt;a href=&quot;https://www.cisa.gov/news-events/alerts/2025/01/29/cisa-adds-one-known-exploited-vulnerability-catalog&quot;&gt;CISA Adds One Known Exploited Vulnerability to Catalog&lt;/a&gt;&lt;/div&gt;[\n]"
[2025-04-14 22:05:02,711][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_pub_date&quot; style=&quot;font-size: 90%; font-style: italic; color: #666666; margin: 0 0 0.3em; padding: 0;&quot;&gt;01/29/2025 03:00 PM EST&lt;/div&gt;[\n]"
[2025-04-14 22:05:02,711][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;br&gt;[\n]"
[2025-04-14 22:05:02,711][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_description&quot; style=&quot;margin: 0 0 0.3em; padding: 0;&quot;&gt;[\n]"
[2025-04-14 22:05:02,711][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;l-full__ma"
[2025-04-14 22:05:02,712][DEBUG][org.apache.http.wire] http-outgoing-1 << "in&quot;&gt;[\n]"
[2025-04-14 22:05:02,712][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;l-page-section l-page-section--rich-text&quot;&gt;[\n]"
[2025-04-14 22:05:02,712][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;l-constrain&quot;&gt;[\n]"
[2025-04-14 22:05:02,713][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;l-page-section__content&quot;&gt;[\n]"
[2025-04-14 22:05:02,713][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA has added one new vulnerability to its[0xc2][0xa0]&lt;a href=&quot;https://www.cisa.gov/known-exploited-vulnerabilities-catalog&quot; title=&quot;Known Exploited Vulnerabilities Catalog&quot;&gt;Known Exploited Vulnerabilities Catalog&lt;/a&gt;, based on evidence of active exploitation&lt;u&gt;, &lt;/u&gt;as confirmed by Fortinet.&lt;/p&gt;[\n]"
[2025-04-14 22:05:02,713][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-14 22:05:02,713][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;[\n]"
[2025-04-14 22:05:02,713][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;a href=&quot;https://www.cve.org/CVERecord?id=CVE-2025-24085&quot; title=&quot;Apple Multiple Products Use-After-Free Vulnerability&quot; class=&quot;ext&quot;&gt;CVE-2025-24085&lt;/a&gt; Apple Multiple Products Use-After-Free Vulnerability&lt;/li&gt;[\n]"
[2025-04-14 22:05:02,713][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-14 22:05:02,713][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;These types of vulnerabilities are frequent attack vectors for malicious cyber actors and pose significant risks to the federal enterprise.&lt;/p&gt;[\n]"
[2025-04-14 22:05:02,713][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;&lt;a href=&quot;https://www.cisa.gov/binding-operational-directive-22-01&quot; title=&quot;Binding Operational Directive (BOD) 22-01: Reducing the Significant Risk of Known Exploited Vulnerabilities&quot;&gt;Binding Operational Directive (BOD) 22-01: Reducing the Significant Risk of Known Exploited Vulnerabilities&lt;/a&gt;[0xc2][0xa0]established the Known Exploited Vulnerabilities Catalog as a living list of known Common Vulnerabilities and Exposures (CVEs) that carry significant risk to the federal enterprise. BOD 22-01 requires Federal Civilian Executive Branch (FCEB) agencies to remediate identified vulnerabilities by the due date to protect FCEB networks against active threats. See the&lt;a&gt;[0xc2][0xa0]&lt;/a&gt;&lt;a href=&quot;https://www.cisa.gov/sites/default/files/publications/Reducing_the_Significant_Risk_of_Known_Exploited_Vulnerabilities_211103.pdf&quot; title=&quot;BOD 22-01 Fact Sheet&quot;&gt;BOD 22-01 Fact Sheet&lt;/a&gt;[0xc2][0xa0]for more information.&lt;/p&gt;[\n]"
[2025-04-14 22:05:02,713][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;Although BOD 22-01 only applies to FCEB agencies, CISA strongly urges all organizations to reduce their exposure to cyberattacks by prioritizing timely remediation of[0xc2][0xa0]&lt;a href=&quot;https://www.cisa.gov/known-exploited-vulnerabilities-catalog&quot; title=&quot;Catalog vulnerabilities&quot;&gt;Catalog vulnerabilities&lt;/a&gt;[0xc2][0xa0]as part of their vulnerability management practice. CISA will continue to add vulnerabilities to the catalog that meet the[0xc2][0xa0]&lt;a href=&quot;https://www.cisa.gov/known-exploited-vulnerabilities&quot; title=&quot;specified criteria&quot;&gt;specified criteria&lt;/a&gt;.&lt;/p&gt;[\n]"
[2025-04-14 22:05:02,713][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;[0xc2][0xa0]&lt;/p&gt;[\n]"
[2025-04-14 22:05:02,713][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;&lt;span&gt;This product is provided subject to this[0xc2][0xa0]&lt;/span&gt;&lt;a href=&quot;https://www.cisa.gov/notification&quot; target=&quot;_blank&quot; title=&quot;Follow link&quot; rel=&quot;noopener&quot;&gt;Notification&lt;/a&gt;&lt;span&gt;[0xc2][0xa0]and this[0xc2][0xa0]&lt;/span&gt;&lt;a href=&quot;https://www.cisa.gov/privacy-policy&quot; target=&quot;_blank&quot; title=&quot;Follow link&quot; rel=&quot;noopener&quot;&gt;Privacy &amp;amp; Use&lt;/a&gt;&lt;span&gt;[0xc2][0xa0]policy.&lt;/span&gt;&lt;/p&gt;[\n]"
