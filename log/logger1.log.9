[2025-04-14 21:29:33,137][DEBUG][org.apache.http.wire] http-outgoing-55 << "                                    <span>[\n]"
[2025-04-14 21:29:33,137][DEBUG][org.apache.http.wire] http-outgoing-55 << "                                        <strong>1.6 Million People Impacted by Data Breach at Laboratory Services Cooperative (2 minute read)</strong>[\n]"
[2025-04-14 21:29:33,137][DEBUG][org.apache.http.wire] http-outgoing-55 << "                                    </span>[\n]"
[2025-04-14 21:29:33,137][DEBUG][org.apache.http.wire] http-outgoing-55 << "</a>[\n]"
