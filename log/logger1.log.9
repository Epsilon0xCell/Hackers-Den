[2025-04-14 22:05:01,120][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                        &lt;strong&gt;Broadcom Warns of Authentication Bypass in VMware Windows Tools (2 minute read)&lt;/strong&gt;[\n]"
[2025-04-14 22:05:01,120][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                    &lt;/span&gt;[\n]"
[2025-04-14 22:05:01,120][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;/a&gt;[\n]"
[2025-04-14 22:05:01,120][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;br&gt;[\n]"
