[2025-04-14 22:05:00,749][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                        &lt;strong&gt;UMMC Facing Class Action Lawsuit for Enabling Cyberstalking Campaign (2 minute read)&lt;/strong&gt;[\n]"
[2025-04-14 22:05:00,749][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                    &lt;/span&gt;[\n]"
[2025-04-14 22:05:00,749][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;/a&gt;[\n]"
[2025-04-14 22:05:00,749][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;br&gt;[\n]"
