[2025-04-14 21:29:33,137][DEBUG][org.apache.http.wire] http-outgoing-55 << "<span style="font-family: &quot;Helvetica Neue&quot;, Helvetica, Arial, Verdana, sans-serif;">[\n]"
[2025-04-14 21:29:33,137][DEBUG][org.apache.http.wire] http-outgoing-55 << "                                    Laboratory Services Cooperative (LSC) suffered a data breach in October that affected 1.6 million individuals. The cyberattack exposed sensitive personal information, including names, contact details, Social Security numbers, health insurance information, and medical records. Some Planned Parenthood patients were impacted.[\n]"
[2025-04-14 21:29:33,137][DEBUG][org.apache.http.wire] http-outgoing-55 << "                                </span>[\n]"
[2025-04-14 21:29:33,137][DEBUG][org.apache.http.wire] http-outgoing-55 << "</span>[\n]"
