[2025-04-14 21:29:33,138][DEBUG][org.apache.http.wire] http-outgoing-55 << "                                    <span>[\n]"
[2025-04-14 21:29:33,138][DEBUG][org.apache.http.wire] http-outgoing-55 << "                                        <strong>Fortinet: Symlink trick gives access to patched FortiGate VPN devices (3 minute read)</strong>[\n]"
[2025-04-14 21:29:33,138][DEBUG][org.apache.http.wire] http-outgoing-55 << "                                    </span>[\n]"
[2025-04-14 21:29:33,138][DEBUG][org.apache.http.wire] http-outgoing-55 << "</a>[\n]"
