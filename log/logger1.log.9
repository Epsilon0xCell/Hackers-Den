[2025-04-14 21:29:33,139][DEBUG][org.apache.http.wire] http-outgoing-55 << "                                <a href="https://tracking.tldrnewsletter.com/CL0/https:%2F%2Feptalights.com%2Fblog%2F04-php-support%3Futm_source=tldrinfosec/1/010001963473c645-a6712889-9ec2-4205-94fa-f1e41d7eae95-000000/mT3bK2poLbU8O5-W29Ln3nvX3b-ccRcUEmeAbQX19hE=400">[\n]"
[2025-04-14 21:29:33,139][DEBUG][org.apache.http.wire] http-outgoing-55 << "                                    <span>[\n]"
[2025-04-14 21:29:33,139][DEBUG][org.apache.http.wire] http-outgoing-55 << "                                        <strong>Static Analysis via Lifted PHP (Zend) Bytecode (7 minute read)</strong>[\n]"
[2025-04-14 21:29:33,139][DEBUG][org.apache.http.wire] http-outgoing-55 << "                                    </span>[\n]"
[2025-04-14 21:29:33,139][DEBUG][org.apache.http.wire] http-outgoing-55 << "</a>[\n]"
