[2025-04-14 22:05:02,642][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_title&quot; style=&quot;font-weight: bold; font-size: 120%; margin: 0 0 0.3em; padding: 0;&quot;&gt;&lt;a href=&quot;https://www.cisa.gov/news-events/alerts/2025/02/11/cisa-releases-two-industrial-control-systems-advisories&quot;&gt;CISA Releases Two Industrial Control Systems Advisories&lt;/a&gt;&lt;/div&gt;[\n]"
[2025-04-14 22:05:02,642][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_pub_date&quot; style=&quot;font-size: 90%; font-style: italic; color: #666666; margin: 0 0 0.3em; padding: 0;&quot;&gt;02/1"
[2025-04-14 22:05:02,644][DEBUG][org.apache.http.wire] http-outgoing-1 << "1/2025 02:00 PM EST&lt;/div&gt;[\n]"
[2025-04-14 22:05:02,644][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;br&gt;[\n]"
[2025-04-14 22:05:02,644][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_description&quot; style=&quot;margin: 0 0 0.3em; padding: 0;&quot;&gt;[\n]"
[2025-04-14 22:05:02,644][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA released two Industrial Control Systems (ICS) advisories on February 11, 2025. These advisories provide timely information about current security issues, vulnerabilities, and exploits surrounding ICS.&lt;/p&gt;[\n]"
[2025-04-14 22:05:02,644][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-14 22:05:02,644][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-24-319-17 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-24-319-17&quot;&gt;2N Access Commander (Update A)&lt;/a&gt;[\n]"
[2025-04-14 22:05:02,644][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-14 22:05:02,645][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-037-04 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-037-04&quot;&gt;Trimble Cityworks (Update A)&lt;/a&gt;[\n]"
[2025-04-14 22:05:02,645][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-14 22:05:02,645][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-14 22:05:02,645][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA encourages users and administrators to review newly released ICS advisories for technical details and mitigations.&lt;/p&gt;[\n]"
