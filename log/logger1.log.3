[2025-04-15 21:50:46,579][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9][0x9][0x9]<category><![CDATA[A Little Sunshine]]></category>[\n]"
[2025-04-15 21:50:46,579][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[Russia's War on Ukraine]]></category>[\n]"
[2025-04-15 21:50:46,579][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[Artem Tamoian]]></category>[\n]"
