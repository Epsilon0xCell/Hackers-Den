[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "<span>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                <a href="https://tracking.tldrnewsletter.com/CL0/https:%2F%2Flinks.tldrnewsletter.com%2FUUT"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "iQb/1/010001963997da28-52b5cf20-8fb2-4207-b00e-277bb9619f6b-000000/IxCTRQzVM_KQYSNkGk48tRxVNDClr_PVnqEotL1Zu5Q=400">[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                    <span>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                        <strong>Google Chrome Fixes Browser History Leaks by Purple [0xe2][0x80][0x9c]Visited[0xe2][0x80][0x9d] Links (2 minute read)</strong>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                    </span>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "</a>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "<br>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "<br>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "<span style="font-family: &quot;Helvetica Neue&quot;, Helvetica, Arial, Verdana, sans-serif;">[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                    Historically, bad actors have been able to track users' browsing history by utilizing the ":visited" CSS selector, which turns links purple. Google is aiming to address this leak by changing the way that the ":visited" selector is applied to only display if the user has visited the site from the current top-level site and frame origin. Effectively, the browser will now display purple links based on the combination of the current site and visited sites.[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                </span>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "</span>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "</div>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "</td></tr></tbody></table>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "[\n]"
