[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                    <span>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                        <strong>GitHub Actions and the Pinning Problem: What 100 Security Projects Reveal (3 minute read)</strong>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                    </span>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "</a>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "<br>[\n]"
