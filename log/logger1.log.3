[2025-04-15 21:50:46,498][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[Mark Lanterman]]></category>[\n]"
[2025-04-15 21:50:46,498][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[mark rasch]]></category>[\n]"
[2025-04-15 21:50:46,498][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[Perkins Coie LLP]]></category>[\n]"
[2025-04-15 21:50:46,498][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[Sean Harrington]]></category>[\n]"
[2025-04-15 21:50:46,498][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[Stephen Allwine]]></category>[\n]"
