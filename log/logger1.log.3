[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                <a href="https://tracking.tldrnewsletter.com/CL0/https:%2F%2Fwww.netspi.com%2Fblog%2Ftechnical-blog%2Fweb-application-pentesting%2Fsecuring-your-salesforce-organization%2F%3Futm_source=tldrinfosec/1/010001963997da28-52b5cf20-8fb2-4207-b00e-277bb9619f6b-000000/2pCkgFybOlfkx8knRa_xOlZxYYpizhHyReWmQGDCMZg=400">[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                    <span>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                        <strong>A Not So Comprehensive Guide to Securing Your Salesforce Organization (12 minute read)</strong>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                    </span>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "</a>[\n]"
