[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "<div class="text-block">[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "<span>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                <a href="https://tracking.tldrnewsletter.com/CL0/https:%2F%2Fwww.bleepingcomputer.com%2Fnews%2Fsecurity%2Fgovtech-giant-conduent-confirms-client-data-stolen-in-january-cyberattack%2F%3Futm_source=tldrinfosec/1/010001963997da28-52b5cf20-8fb2-4207-b00e-277bb9619f6b-000000/it1EDASCnPnJpTTXZPdAy_XH1RfWRGMmS4W4fM6G8gs=400">[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                    <span>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                        <strong>Govtech Giant Conduent Confirms Client Data Stolen in January Cyberattack (2 minute read)</strong>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                    </span>[\n]"
[2025-04-15 21:50:54,714][DEBUG][org.apache.http.wire] http-outgoing-67 << "</a>[\n]"
