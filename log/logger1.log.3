[2025-04-15 21:50:54,713][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                    <span>[\n]"
[2025-04-15 21:50:54,713][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                        <strong>Hertz says customers' personal data and driver's licenses stolen in data breach (2 minute read)</strong>[\n]"
[2025-04-15 21:50:54,713][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                    </span>[\n]"
[2025-04-15 21:50:54,713][DEBUG][org.apache.http.wire] http-outgoing-67 << "</a>[\n]"
[2025-04-15 21:50:54,713][DEBUG][org.apache.http.wire] http-outgoing-67 << "<br>[\n]"
[2025-04-15 21:50:54,713][DEBUG][org.apache.http.wire] http-outgoing-67 << "<br>[\n]"
[2025-04-15 21:50:54,713][DEBUG][org.apache.http.wire] http-outgoing-67 << "<span style="font-family: &quot;Helvetica Neue&quot;, Helvetica, Arial, Verdana, sans-serif;">[\n]"
[2025-04-15 21:50:54,713][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                    Hertz has reported a data breach that affects customers across multiple regions due to a cyberattack on vendor Cleo Software between October and December 2024. Exposed data includes names, contact information, driver's licenses, payment details, and some Social Security numbers.[\n]"
[2025-04-15 21:50:54,713][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                </span>[\n]"
[2025-04-15 21:50:54,713][DEBUG][org.apache.http.wire] http-outgoing-67 << "</span>[\n]"
[2025-04-15 21:50:54,713][DEBUG][org.apache.http.wire] http-outgoing-67 << "</div>[\n]"
[2025-04-15 21:50:54,713][DEBUG][org.apache.http.wire] http-outgoing-67 << "</td></tr></tbody></table>[\n]"
