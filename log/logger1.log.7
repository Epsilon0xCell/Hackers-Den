[2025-04-14 22:05:18,221][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[ClickFix]]></category>[\n]"
[2025-04-14 22:05:18,221][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[Facebook]]></category>[\n]"
[2025-04-14 22:05:18,221][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[Google Chrome]]></category>[\n]"
[2025-04-14 22:05:18,221][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[Microsoft Office]]></category>[\n]"
[2025-04-14 22:05:18,221][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[Microsoft Windows]]></category>[\n]"
[2025-04-14 22:05:18,221][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[mshta.exe]]></category>[\n]"
[2025-04-14 22:05:18,221][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[proofpoint]]></category>[\n]"
