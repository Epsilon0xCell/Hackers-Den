[2025-04-14 22:05:18,217][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[national security agency]]></category>[\n]"
[2025-04-14 22:05:18,217][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[NBC News]]></category>[\n]"
[2025-04-14 22:05:18,217][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[Rob Joyce]]></category>[\n]"
[2025-04-14 22:05:18,217][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[Shane Harris]]></category>[\n]"
[2025-04-14 22:05:18,218][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[Starlink]]></category>[\n]"
[2025-04-14 22:05:18,218][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[Techdirt]]></category>[\n]"
[2025-04-14 22:05:18,218][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[The Atlantic]]></category>[\n]"
