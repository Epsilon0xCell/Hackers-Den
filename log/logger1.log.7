[2025-04-14 22:05:23,817][DEBUG][org.apache.http.wire] http-outgoing-56 << "                                        <strong>1.6 Million People Impacted by Data Breach at Laboratory Services Cooperative (2 minute read)</strong>[\n]"
[2025-04-14 22:05:23,817][DEBUG][org.apache.http.wire] http-outgoing-56 << "                                    </span>[\n]"
[2025-04-14 22:05:23,817][DEBUG][org.apache.http.wire] http-outgoing-56 << "</a>[\n]"
