[2025-04-14 21:29:25,381][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;&lt;a href=&quot;https://learn.assetlifecycle.trimble.com/i/1532182-cityworks-customer-communication-2025-02-05-docx/0?&quot; title=&quot;Trimble Advisory&quot;&gt;Trimble Advisory and IOCs for Vulnerability Affecting Cityworks Deployments[0xc2][0xa0]&lt;/a&gt;&lt;/li&gt;[\n]"
[2025-04-14 21:29:25,381][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/ul&gt;[\n]"
[2025-04-14 21:29:25,381][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/div&gt;[\n]"
