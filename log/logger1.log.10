[2025-04-14 21:29:24,155][DEBUG][org.apache.http.wire] http-outgoing-18 << "                                    &lt;/span&gt;[\n]"
[2025-04-14 21:29:24,155][DEBUG][org.apache.http.wire] http-outgoing-18 << "&lt;/a&gt;[\n]"
[2025-04-14 21:29:24,155][DEBUG][org.apache.http.wire] http-outgoing-18 << "&lt;br&gt;[\n]"
