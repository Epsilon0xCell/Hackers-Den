[2025-04-14 21:29:25,353][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;div class=&quot;rss_description&quot; style=&quot;margin: 0 0 0.3em; padding: 0;&quot;&gt;[\n]"
[2025-04-14 21:29:25,353][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;p&gt;CISA released two Industrial Control Systems (ICS) advisories on February 18, 2025. These advisories provide timely information about current security issues, vulnerabilities, and exploits surrounding ICS.&lt;/p&gt;[\n]"
[2025-04-14 21:29:25,353][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;ul&gt;[\n]"
[2025-04-14 21:29:25,353][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSA-24-191-01 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-24-191-01&quot;&gt;Delta Electronics CNCSoft-G2 (Update A)&lt;/a&gt;[\n]"
[2025-04-14 21:29:25,353][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/li&gt;[\n]"
[2025-04-14 21:29:25,353][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;ICSA-25-035-02 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-035-02&quot;&gt;Rockwell Automation GuardLogix 5380 and 5580 (Update A)&lt;/a&gt;[\n]"
[2025-04-14 21:29:25,353][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/li&gt;[\n]"
[2025-04-14 21:29:25,353][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/ul&gt;[\n]"
[2025-04-14 21:29:25,353][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;p&gt;CISA encourages users and administrators to review newly released ICS advisories for technical details and mitigations.&lt;/p&gt;[\n]"
