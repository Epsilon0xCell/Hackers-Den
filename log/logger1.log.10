[2025-04-14 21:29:25,037][DEBUG][org.apache.http.wire] http-outgoing-19 << "    &lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 10.0pt; color: #757575;&quot;&gt;Having trouble viewing this message?[0xc2][0xa0]&lt;/span&gt;&lt;a href=&quot;https://content.govdelivery.com/accounts/USDHSCISA/bulletins/3da79f4&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;View it as a webpage&lt;/a&gt;.[0xc2][0xa0]&lt;a href=&quot;https://content.govdelivery.com/accounts/USDHS/bulletins/292141e&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;&lt;/a&gt;&lt;span style=&quot;font-size: 10.0pt; color: #757575;&quot;&gt;&lt;/span&gt;&lt;/p&gt;[\n]"
[2025-04-14 21:29:25,037][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 10.0pt; color: #757575;&quot;&gt;You are subscribed to updates from the &lt;/span&gt;&lt;a href=&quot;https://www.cisa.gov&quot;&gt;&lt;span style=&quot;font-size: 10.0pt;&quot;&gt;Cybersecurity and Infrastructure Security Agency&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot;font-size: 10.0pt; color: #757575;&quot;&gt; (CISA)&lt;br&gt;&lt;/span&gt;&lt;a href=&quot;https://public.govdelivery.com/accounts/USDHSCISA/subscriber/edit?preferences=true#tab1&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;&lt;span style=&quot;font-size: 10.0pt; color: #00568c;&quot;&gt;Manage Subscriptions&lt;/span&gt;&lt;/a&gt;[0xc2][0xa0][0xc2][0xa0]&lt;span style=&quot;font-size: 10.0pt; color: #757575;&quot;&gt;|[0xc2][0xa0][0xc2][0xa0]&lt;/span&gt;&lt;a href=&quot;https://www.cisa.gov/privacy-policy&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;&lt;span style=&quot;font-size: 10.0pt; color: #00568c;&quot;&gt;Privacy Policy&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot;font-size: 10.0pt; color: #757575;&quot;&gt;[0xc2][0xa0][0xc2][0xa0]|[0xc2][0xa0] &lt;a href=&quot;https://subscriberhelp.granicus.com/s/article/Subscriber-Help-Center&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Help&lt;/a&gt;&lt;a href=&quot;https://insights.govdelivery.com/Communications/Subscriber_Help_Center&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;&lt;/a&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 10.0pt; color: #757575;&quot;&gt;&lt;/span&gt;&lt;/p&gt;[\n]"
[2025-04-14 21:29:25,037][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 10.0pt; color: #757575;&quot;&gt;Connect with CISA: &lt;br&gt;&lt;/span&gt;&lt;a href=&quot;https://www.facebook.com/CISA&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;&lt;span style=&quot;font-size: 10.0pt; color: #00568c;&quot;&gt;Facebook&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot;font-size: 10.0pt; color: #757575;&quot;&gt;[0xc2][0xa0] |[0xc2][0xa0] &lt;/span&gt;&lt;a href=&quot;https://twitter.com/CISAgov&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;&lt;span style=&quot;font-size: 10.0pt; color: #00568c;&quot;&gt;Twitter&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot;font-size: 10.0pt; color: #757575;&quot;&gt;[0xc2][0xa0] |[0xc2][0xa0] &lt;/span&gt;&lt;a href=&quot;https://Instagram.com/cisagov&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;&lt;span style=&quot;font-size: 10.0pt; color: #00568c;&quot;&gt;Instagram&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot;font-size: 10.0pt; color: #757575;&quot;&gt;[0xc2][0xa0] |[0xc2][0xa0] &lt;/span&gt;&lt;a href=&quot;https://www.linkedin.com/company/cybersecurity-and-infrastructure-security-agency&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;&lt;span style=&quot;font-size: 10.0pt; color: #00568c;&quot;&gt;LinkedIn&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot;font-size: 10.0pt; color: #757575;&quot;&gt;[0xc2][0xa0] |[0xc2][0xa0][0xc2][0xa0] &lt;/span&gt;&lt;a href=&quot;https://www.youtube.com/channel/UCxyq9roe-npgzrVwbpoAy0A&quot; target=&quot;_self&quot;&gt;&lt;span style=&quot;font-size: 10.0pt; color: #00568c;&quot;&gt;YouTube&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot;font-size: 10.0pt; color: #757575;&quot;&gt;&lt;/span&gt;&lt;/p&gt;[\n]"
