[2025-04-14 21:29:25,249][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;ul&gt;[\n]"
[2025-04-14 21:29:25,249][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;li&gt;StepSecurity: &lt;a href=&quot;https://www.stepsecurity.io/blog/harden-runner-detection-tj-actions-changed-files-action-is-compromised#recovery-steps&quot; target=&quot;_blank&quot; title=&quot;Harden-Runner detection: tj-actions/changed-files action is compromised&quot; rel=&quot;noopener&quot;&gt;Harden-Runner detection: tj-actions/changed-files action is compromised&lt;/a&gt;[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-14 21:29:25,249][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/ul&gt;[\n]"
[2025-04-14 21:29:25,249][DEBUG][org.apache.http.wire] http-outgoing-19 << "&lt;/div&gt;[\n]"
