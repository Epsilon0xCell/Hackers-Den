[2025-04-14 21:29:24,073][DEBUG][org.apache.http.wire] http-outgoing-18 << "                                        &lt;strong&gt;UMMC Facing Class Action Lawsuit for Enabling Cyberstalking Campaign (2 minute read)&lt;/strong&gt;[\n]"
[2025-04-14 21:29:24,073][DEBUG][org.apache.http.wire] http-outgoing-18 << "                                    &lt;/span&gt;[\n]"
[2025-04-14 21:29:24,073][DEBUG][org.apache.http.wire] http-outgoing-18 << "&lt;/a&gt;[\n]"
[2025-04-14 21:29:24,073][DEBUG][org.apache.http.wire] http-outgoing-18 << "&lt;br&gt;[\n]"
