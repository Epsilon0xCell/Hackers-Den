[2025-04-14 22:19:53,341][DEBUG][org.apache.http.wire] http-outgoing-6 << "[0x9][0x9]<category><![CDATA[Microsoft Office]]></category>[\n]"
[2025-04-14 22:19:53,341][DEBUG][org.apache.http.wire] http-outgoing-6 << "[0x9][0x9]<category><![CDATA[Microsoft Windows]]></category>[\n]"
[2025-04-14 22:19:53,341][DEBUG][org.apache.http.wire] http-outgoing-6 << "[0x9][0x9]<category><![CDATA[mshta.exe]]></category>[\n]"
[2025-04-14 22:19:53,341][DEBUG][org.apache.http.wire] http-outgoing-6 << "[0x9][0x9]<category><![CDATA[proofpoint]]></category>[\n]"
