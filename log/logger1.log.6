[2025-04-14 22:19:53,336][DEBUG][org.apache.http.wire] http-outgoing-6 << "[0x9][0x9]<category><![CDATA[Rob Joyce]]></category>[\n]"
[2025-04-14 22:19:53,336][DEBUG][org.apache.http.wire] http-outgoing-6 << "[0x9][0x9]<category><![CDATA[Shane Harris]]></category>[\n]"
[2025-04-14 22:19:53,336][DEBUG][org.apache.http.wire] http-outgoing-6 << "[0x9][0x9]<category><![CDATA[Starlink]]></category>[\n]"
[2025-04-14 22:19:53,336][DEBUG][org.apache.http.wire] http-outgoing-6 << "[0x9][0x9]<category><![CDATA[Techdirt]]></category>[\n]"
[2025-04-14 22:19:53,336][DEBUG][org.apache.http.wire] http-outgoing-6 << "[0x9][0x9]<category><![CDATA[The Atlantic]]></category>[\n]"
