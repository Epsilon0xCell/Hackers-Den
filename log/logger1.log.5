[2025-04-15 21:50:32,109][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                        &lt;strong&gt;Researchers Hack Source Code From Google Gemini (7 minute read)&lt;/strong&gt;[\n]"
[2025-04-15 21:50:32,109][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                    &lt;/span&gt;[\n]"
[2025-04-15 21:50:32,109][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;/a&gt;[\n]"
