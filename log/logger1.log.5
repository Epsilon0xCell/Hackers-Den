[2025-04-15 21:50:32,345][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                        &lt;strong&gt;Outlaw Linux Malware: Persistent, Unsophisticated, and Surprisingly Effective (33 minute read)&lt;/strong&gt;[\n]"
[2025-04-15 21:50:32,345][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                    &lt;/span&gt;[\n]"
[2025-04-15 21:50:32,345][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;/a&gt;[\n]"
