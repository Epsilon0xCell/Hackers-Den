[2025-04-15 21:50:33,637][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_description&quot; style=&quot;margin: 0 0 0.3em; padding: 0;&quot;&gt;[\n]"
[2025-04-15 21:50:33,637][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA released two Industrial Control Systems (ICS) advisories on February 25, 2025. These advisories provide timely information about current security issues, vulnerabilities, and exploits surrounding ICS.&lt;/p&gt;[\n]"
[2025-04-15 21:50:33,637][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-15 21:50:33,637][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-056-01 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-056-01&quot;&gt;Rockwell Automation PowerFlex 755&lt;/a&gt;&lt;br&gt;[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-15 21:50:33,637][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSMA-25-"
[2025-04-15 21:50:33,639][DEBUG][org.apache.http.wire] http-outgoing-1 << "030-01 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-medical-advisories/icsma-25-030-01&quot;&gt;Contec Health CMS8000 Patient Monitor (UpdateA)&lt;/a&gt;&lt;br&gt;[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-15 21:50:33,640][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-15 21:50:33,640][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA encourages users and administrators to review newly released ICS advisories for technical details and mitigations.&lt;/p&gt;[\n]"
