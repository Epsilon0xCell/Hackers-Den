[2025-04-15 21:50:33,424][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA released five Industrial Control Systems (ICS) advisories on April3, 2025. These advisories provide timely information about current security issues, vulnerabilities, and exploits surrounding ICS.&lt;/p&gt;[\n]"
[2025-04-15 21:50:33,424][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-15 21:50:33,424][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-093-01 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-093-01&quot;&gt;Hitachi Energy RTU500 Series&lt;/a&gt;[\n]"
[2025-04-15 21:50:33,424][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-15 21:50:33,424][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-093-02 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-093-02&quot;&gt;Hitachi Energy TRMTracker&lt;/a&gt;[\n]"
[2025-04-15 21:50:33,424][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-15 21:50:33,424][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-093-03 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-093-03&quot;&gt;ABB ACS880 Drives Containing CODESYS RTS&lt;/a&gt;[\n]"
[2025-04-15 21:50:33,424][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-15 21:50:33,425][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-093-04 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-093-04&quot;&gt;ABB Low Voltage DC Drives and Power Controllers CODESYS RTS&lt;/a&gt;[\n]"
[2025-04-15 21:50:33,425][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-15 21:50:33,425][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-093-05 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-093-05&quot;&gt;B&amp;amp;R APROL&lt;/a&gt;[\n]"
[2025-04-15 21:50:33,425][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-15 21:50:33,425][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-15 21:50:33,425][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA encourages users and administrators to review newly released ICS advisories for technical details and mitigations.&lt;/p&gt;[\n]"
