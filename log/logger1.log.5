[2025-04-15 21:50:32,587][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                    &lt;span&gt;[\n]"
[2025-04-15 21:50:32,588][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                        &lt;strong&gt;Compromising Threat Actor Communications (12 minute read)&lt;/strong&gt;[\n]"
[2025-04-15 21:50:32,588][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                    &lt;/span&gt;[\n]"
[2025-04-15 21:50:32,588][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;/a&gt;[\n]"
[2025-04-15 21:50:32,588][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;br&gt;[\n]"
