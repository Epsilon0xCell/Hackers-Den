[2025-04-15 21:50:31,888][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                        &lt;strong&gt;Google Chrome Fixes Browser History Leaks by Purple [0xe2][0x80][0x9c]Visited[0xe2][0x80][0x9d] Links (2 minute read)&lt;/strong&gt;[\n]"
[2025-04-15 21:50:31,888][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                    &lt;/span&gt;[\n]"
[2025-04-15 21:50:31,888][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;/a&gt;[\n]"
