[2025-04-15 21:50:33,601][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_title&quot; style=&quot;font-weight: bold; font-size: 120%; margin: 0 0 0.3em; padding: 0;&quot;&gt;&lt;a href=&quot;https://www.cisa.gov/news-events/alerts/2025/03/06/cisa-releases-three-industrial-control-systems-advisories&quot;&gt;CISA Releases Three Industrial Control Systems Advisories&lt;/a&gt;&lt;/div&gt;[\n]"
[2025-04-15 21:50:33,601][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_pub_date&quot; style=&quot;font-size: 90%; font-style: italic; color: #666666; margin: 0 0 0.3em; padding: 0;&quot;&gt;03/06/2025 2:00 PM EST&lt;/div&gt;[\n]"
[2025-04-15 21:50:33,601][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;br&gt;[\n]"
[2025-04-15 21:50:33,601][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_description&quot; style=&quot;margin: 0 0 0.3em; padding: 0;&quot;&gt;[\n]"
[2025-04-15 21:50:33,601][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA released three Industrial Control Systems (ICS) advisories on March 6, 2025. These advisories provide timely information about current security issues, vulnerabilities, and exploits surrounding ICS.&lt;/p&gt;[\n]"
[2025-04-15 21:50:33,601][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-15 21:50:33,601][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-065-01 &l"
[2025-04-15 21:50:33,603][DEBUG][org.apache.http.wire] http-outgoing-1 << "t;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-065-01&quot;&gt;Hitachi Energy PCU400&lt;/a&gt;[\n]"
[2025-04-15 21:50:33,603][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-15 21:50:33,603][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-065-02 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-065-02&quot;&gt;Hitachi Energy Relion 670/650/SAM600-IO&lt;/a&gt;&lt;br&gt;[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-15 21:50:33,603][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-037-02 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-037-01&quot;&gt;Schneider Electric EcoStruxure (Update A)&lt;/a&gt;&lt;br&gt;[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-15 21:50:33,604][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-15 21:50:33,604][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA encourages users and administrators to review newly released ICS advisories for technical details and mitigations.&lt;/p&gt;[\n]"
