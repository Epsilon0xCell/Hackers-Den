[2025-04-15 21:50:32,276][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                        &lt;strong&gt;UMMC Facing Class Action Lawsuit for Enabling Cyberstalking Campaign (2 minute read)&lt;/strong&gt;[\n]"
[2025-04-15 21:50:32,276][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                    &lt;/span&gt;[\n]"
[2025-04-15 21:50:32,276][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;/a&gt;[\n]"
[2025-04-15 21:50:32,276][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;br&gt;[\n]"
