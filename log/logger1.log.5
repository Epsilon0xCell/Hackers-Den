[2025-04-15 21:50:33,524][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_title&quot; style=&quot;font-weight: bold; font-size: 120%; margin: 0 0 0.3em; padding: 0;&quot;&gt;&lt;a href=&quot;https://www.cisa.gov/news-events/alerts/2025/03/25/cisa-releases-four-industrial-control-systems-advisories&quot;&gt;CISA Releases Four Industrial Control Systems Advisories&lt;/a&gt;&lt;/div&gt;[\n]"
[2025-04-15 21:50:33,524][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_pub_date&quot; style=&quot;font-size: 90%; font-style: italic; color: #666666; margin: 0 0 0.3em; padding: 0;&quot;&gt;03/25/2025 01:45 PM EDT&lt;/div&gt;[\n]"
[2025-04-15 21:50:33,524][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;br&gt;[\n]"
[2025-04-15 21:50:33,524][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;div class=&quot;rss_description&quot; style=&quot;margin: 0 0 0.3em; padding: 0;&quot;&gt;[\n]"
[2025-04-15 21:50:33,524][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA released four Industrial Control Systems (ICS) advisories on March 25, 2025. These advisories provide timely information about current security issues, vulnerabilities, and exploits surrounding ICS.&lt;/p&gt;[\n]"
[2025-04-15 21:50:33,524][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;ul&gt;[\n]"
[2025-04-15 21:50:33,524][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-084-01 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-084-01&quot;&gt;ABB RMC-100&lt;/a&gt;[\n]"
[2025-04-15 21:50:33,524][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-15 21:50:33,525][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-084-02 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-084-02&quot;&gt;Rockwell Automation Verve Asset Manager&lt;/a&gt;[\n]"
[2025-04-15 21:50:33,525][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-15 21:50:33,525][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-084-03 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-084-03&quot;&gt;Rockwell Automation 440G TLS-Z&lt;/a&gt;[\n]"
[2025-04-15 21:50:33,525][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/li&gt;[\n]"
[2025-04-15 21:50:33,525][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;li&gt;ICSA-25-084-04 &lt;a href=&quot;https://www.cisa.gov/news-events/ics-advisories/icsa-25-084-04&quot;&gt;Inaba Denki Sangyo CHOCO TEI WATCHER Mini[0xc2][0xa0]&lt;/a&gt;&lt;br&gt;[0xc2][0xa0]&lt;/li&gt;[\n]"
[2025-04-15 21:50:33,525][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;/ul&gt;[\n]"
[2025-04-15 21:50:33,525][DEBUG][org.apache.http.wire] http-outgoing-1 << "&lt;p&gt;CISA encourages users and administrators to review newly released ICS advisories for technical details and mitigations.&lt;/p&gt;[\n]"
