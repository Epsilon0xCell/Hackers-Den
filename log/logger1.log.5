[2025-04-15 21:50:32,621][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                        &lt;strong&gt;[0xf0][0x9f][0x86][0x95]&amp;nbsp;Chainguard Libraries: Guarded Java Language Dependencies to Eliminate Supply Chain Attacks (Sponsor)&lt;/strong&gt;[\n]"
[2025-04-15 21:50:32,621][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                    &lt;/span&gt;[\n]"
[2025-04-15 21:50:32,621][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;/a&gt;[\n]"
[2025-04-15 21:50:32,621][DEBUG][org.apache.http.wire] http-outgoing-0 << "[\n]"
