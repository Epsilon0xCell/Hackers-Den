[2025-04-14 22:20:00,075][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9][0x9][0x9]<category><![CDATA[A Little Sunshine]]></category>[\n]"
[2025-04-14 22:20:00,075][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[DOGE]]></category>[\n]"
[2025-04-14 22:20:00,075][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[The Coming Storm]]></category>[\n]"
[2025-04-14 22:20:00,075][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[Central Intelligence Agency]]></category>[\n]"
[2025-04-14 22:20:00,075][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[Christopher Stanley]]></category>[\n]"
