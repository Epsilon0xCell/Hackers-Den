[2025-04-15 21:50:32,296][DEBUG][org.apache.http.wire] http-outgoing-0 << "                                    &lt;/span&gt;[\n]"
[2025-04-15 21:50:32,296][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;/a&gt;[\n]"
[2025-04-15 21:50:32,296][DEBUG][org.apache.http.wire] http-outgoing-0 << "&lt;br&gt;[\n]"
