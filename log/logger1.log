[2025-04-15 21:52:32,146][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                        <strong>Hertz says customers' personal data and driver's licenses stolen in data breach (2 minute read)</strong>[\n]"
[2025-04-15 21:52:32,146][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                    </span>[\n]"
[2025-04-15 21:52:32,146][DEBUG][org.apache.http.wire] http-outgoing-67 << "</a>[\n]"
