[2025-04-15 21:52:32,148][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                        <strong>Threat Modeling GitHub - How Vulnerable-by-Design is GitHub? (7 minute read)</strong>[\n]"
[2025-04-15 21:52:32,148][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                    </span>[\n]"
[2025-04-15 21:52:32,148][DEBUG][org.apache.http.wire] http-outgoing-67 << "</a>[\n]"
