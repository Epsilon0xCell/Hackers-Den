[2025-04-15 21:52:32,146][DEBUG][org.apache.http.wire] http-outgoing-67 << "<span style="font-family: &quot;Helvetica Neue&quot;, Helvetica, Arial, Verdana, sans-serif;">[\n]"
[2025-04-15 21:52:32,146][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                    Hertz has reported a data breach that affects customers across multiple regions due to a cyberattack on vendor Cleo Software between October and December 2024. Exposed data includes names, contact information, driver's licenses, payment details, and some Social Security numbers.[\n]"
[2025-04-15 21:52:32,146][DEBUG][org.apache.http.wire] http-outgoing-67 << "                                </span>[\n]"
[2025-04-15 21:52:32,146][DEBUG][org.apache.http.wire] http-outgoing-67 << "</span>[\n]"
