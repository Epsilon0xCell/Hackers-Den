[2025-04-14 04:21:02,587][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[NBC News]]></category>[\n]"
[2025-04-14 04:21:02,587][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[Rob Joyce]]></category>[\n]"
[2025-04-14 04:21:02,587][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[Shane Harris]]></category>[\n]"
[2025-04-14 04:21:02,587][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[Starlink]]></category>[\n]"
[2025-04-14 04:21:02,587][DEBUG][org.apache.http.wire] http-outgoing-24 << "[0x9][0x9]<category><![CDATA[Techdirt]]></category>[\n]"
